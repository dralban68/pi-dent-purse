{
  "name": "pi-dent-purse",
  "version": "0.2.0",
  "description": "A pi extension that collects per-provider LLM billing state and serves it to other extensions and the user",
  "keywords": [
    "billing",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/dralban68/pi-dent-purse#readme",
  "bugs": "https://github.com/dralban68/pi-dent-purse/issues",
  "license": "MIT",
  "author": "Chris B <dralban68@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dralban68/pi-dent-purse.git"
  },
  "files": [
    "index.ts",
    "lib/"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.6.6",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
